generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String    @id @default(uuid())
  sessionToken    String    @unique
  firebaseUid     String?   @unique
  rating          Float     @default(1200)
  ratingDeviation Float     @default(350)
  volatility      Float     @default(0.06)
  gamesPlayed     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastActiveAt    DateTime  @default(now())
  attempts        Attempt[]
  reports         Report[]

  @@index([sessionToken])
  @@index([firebaseUid])
  @@index([rating])
  @@index([lastActiveAt])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerType {
  FREE_RESPONSE
  MULTIPLE_CHOICE
}

model Problem {
  id              String     @id @default(uuid())
  content         String     // Problem text (can include LaTeX)
  answer          String     // Correct answer (letter for MC, value for FR)
  answerType      AnswerType @default(FREE_RESPONSE)
  choices         String[]   // MC choices: ["A. ...", "B. ...", ...] (empty for FR)
  rating          Float      @default(1500)
  ratingDeviation Float      @default(350)
  volatility      Float      @default(0.06)
  difficulty      Difficulty
  source          String?    // e.g. "2024 AMC 8", "2024 AIME I"
  sourceNumber    Int?       // Problem number (1-25 or 1-15)
  createdAt       DateTime   @default(now())
  attempts        Attempt[]
  reports         Report[]

  @@unique([source, sourceNumber])
  @@index([rating])
  @@index([difficulty])
}

model Attempt {
  id           String   @id @default(uuid())
  playerId     String
  problemId    String
  answer       String   // Player's submitted answer
  correct      Boolean
  ratingBefore Float    // Player's rating before this attempt
  ratingAfter  Float    // Player's rating after this attempt
  createdAt    DateTime @default(now())

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([problemId])
  @@index([createdAt])
  @@index([playerId, createdAt])
}

enum ReportType {
  FORMATTING
  WRONG_ANSWER
  OTHER
}

model Report {
  id        String     @id @default(uuid())
  problemId String
  playerId  String?
  type      ReportType
  details   String?
  createdAt DateTime   @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([problemId])
}
